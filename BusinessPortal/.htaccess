# BusinessPortal/.htaccess — PWA + service worker MIME types

<IfModule mod_mime.c>
    # Web App Manifest
    AddType application/manifest+json   .webmanifest
    AddType application/json            .json

    # Service worker MUST be JS
    AddType application/javascript      .js
</IfModule>

<IfModule mod_headers.c>
    # Service worker should never be cached too long, otherwise updates won't reach clients
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header set Service-Worker-Allowed "/BusinessPortal/"
    </FilesMatch>

    # Manifests can revalidate frequently
    <FilesMatch "\.webmanifest$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>
